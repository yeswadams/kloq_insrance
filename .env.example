DATABASE_URL=postgres://postgres:postgres@localhost:5432/kloq_insurance
BETTER_AUTH_URL=http://localhost:3000
# Generate a unique secret for production; the app supplies a local-only development fallback.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Required for remote Chromium browser executions. Keep this server-only.
E2B_API_KEY=
# E2B template rebuilt with envd >= 0.2.0 (secured access support).
E2B_BROWSER_TEMPLATE=playwright-chromium
# HTTPS base URL publicly reachable from E2B (e.g. your deployed app or HTTPS tunnel), no path suffix.
MOCK_PORTAL_BASE_URL=
